{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "*": ["./*"],
      "@email": ["./src/email/index.ts"],
      "@email/*": ["./src/email/*"],
      "@coverflex": ["./src/coverflex/index.ts"],
      "@coverflex/*": ["./src/coverflex/*"],
      "@x": ["./src/x/index.ts"],
      "@x/*": ["./src/x/*"],
      "@rss": ["./src/rss/scrapers.ts"],
      "@rss/*": ["./src/rss/*"],
      "@types": ["./src/types.ts"]
    }
  },
  // `cf workers types` and the Vite plugin write Worker types here. TypeScript skips dot directories by default.
  "include": ["**/*", ".cloudflare/types/index.d.ts"],
  "exclude": ["tools/oxlint/anti-slop"]
}
