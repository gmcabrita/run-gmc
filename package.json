{
  "name": "run-gmc",
  "type": "module",
  "scripts": {
    "localflare": "localflare attach",
    "dev": "wrangler dev",
    "build": "wrangler deploy --minify --outdir dist --dry-run",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject dist && sentry-cli sourcemaps upload --org=goncalo-mendes-cabrita --project=run-gmc dist",
    "deploy": "pnpm build && pnpm sentry:sourcemaps && wrangler deploy dist/index.js --no-bundle --upload-source-maps",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "coverflex-uat": "pnpm dlx tsx bin/coverflex-uat.ts",
    "test": "vitest",
    "fmt": "oxfmt --write .",
    "lint": "oxfmt --check . && oxlint",
    "skills:update": "skills add cloudflare/skills --skill cloudflare --skill durable-objects --skill workers-best-practices --agent universal --yes",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@sentry/cloudflare": "^10.71.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "feed": "^6.0.0",
    "hono": "^4.13.5",
    "valibot": "^1.4.2",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@nkzw/oxlint-config": "^1.3.0",
    "@oxlint/plugins": "^1.80.0",
    "@sentry/cli": "^3.6.2",
    "@types/node": "^26.4.0",
    "@types/xml2js": "^0.4.14",
    "localflare": "^0.5.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "skills": "^1.5.23",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
